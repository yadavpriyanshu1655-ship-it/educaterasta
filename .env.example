# Educaterasta Environment Configuration Template
# Copy this file to .env and adjust variables as required.

# Application
PROJECT_NAME="Educaterasta"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# Database (Default: SQLite for local development)
DATABASE_URL="sqlite:///./educaterasta.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"

